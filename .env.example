# Example environment variables (copy to .env and fill in real values)
# Never commit your real .env file to GitHub.

# ThingSpeak
THINGSPEAK_WRITE_API_KEY=your_write_api_key_here
THINGSPEAK_CHANNEL_ID=your_channel_id_here

# MQTT Broker (if using a private broker)
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=farm/node1/data

# WiFi credentials (for ESP32/Wokwi, not used in Python simulation)
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password
